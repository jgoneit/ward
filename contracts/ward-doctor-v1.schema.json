{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jgoneit/ward/contracts/ward-doctor-v1.schema.json",
  "title": "Ward doctor report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "healthy", "checks"],
  "properties": {
    "schema": { "const": "ward-doctor/v1" },
    "healthy": { "type": "boolean" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "message"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$" },
          "status": { "enum": ["pass", "fail", "warn"] },
          "message": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
