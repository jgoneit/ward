{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jgoneit/ward/contracts/ward-decision-v1.schema.json",
  "title": "Ward veto-only decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "outcome", "reason"],
  "properties": {
    "schema": { "const": "ward-decision/v1" },
    "outcome": { "enum": ["deny", "defer", "error"] },
    "rule_id": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "error_code": { "type": "string", "minLength": 1 },
    "coverage_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "deny" } } },
      "then": {
        "required": ["rule_id"],
        "not": { "anyOf": [{ "required": ["error_code"] }, { "required": ["coverage_gap"] }] }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "defer" } } },
      "then": {
        "not": { "anyOf": [{ "required": ["rule_id"] }, { "required": ["error_code"] }] }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "error" } } },
      "then": {
        "required": ["error_code"],
        "not": { "anyOf": [{ "required": ["rule_id"] }, { "required": ["coverage_gap"] }] }
      }
    }
  ]
}
