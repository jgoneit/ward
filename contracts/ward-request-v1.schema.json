{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jgoneit/ward/contracts/ward-request-v1.schema.json",
  "title": "Ward canonical request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "host", "event", "tool", "cwd", "input"],
  "properties": {
    "schema": { "const": "ward-request/v1" },
    "host": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "event": { "enum": ["PreToolUse", "PermissionRequest"] },
    "tool": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "cwd": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "maxLength": 1048576, "pattern": "^[^\\u0000]*$" },
        "paths": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "allOf": [
              { "pattern": "^[^\\u0000]*$" },
              { "pattern": "\\S" }
            ]
          }
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "allOf": [
            { "pattern": "^[^\\u0000]*$" },
            { "pattern": "\\S" }
          ]
        },
        "destination_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "allOf": [
            { "pattern": "^[^\\u0000]*$" },
            { "pattern": "\\S" }
          ]
        }
      },
      "anyOf": [
        {
          "required": ["command"],
          "properties": { "command": { "minLength": 1, "pattern": "\\S" } }
        },
        {
          "required": ["paths"],
          "properties": { "paths": { "minItems": 1 } }
        }
      ]
    }
  }
}
