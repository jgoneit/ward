{
  "description": "frozen pre-v2 host hooks",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "/private/tmp/ward-frozen-v1-home/codex/ward/bin/ward hook codex-permission-request",
            "statusMessage": "Ward: evaluating permission request",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/private/tmp/ward-frozen-v1-home/codex/ward/bin/ward hook codex-post-tool-use",
            "statusMessage": "Ward: recording tool result",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/bin/true",
            "timeout": 1,
            "type": "command"
          }
        ],
        "matcher": "^Read$"
      },
      {
        "hooks": [
          {
            "command": "/private/tmp/ward-frozen-v1-home/codex/ward/bin/ward hook codex-pre-tool-use",
            "statusMessage": "Ward: evaluating tool request",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}
